# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gpj_db"

# Server
PORT=8000
NODE_ENV=development

# AWS S3 Configuration
S3_ACCESS_KEY=your_aws_access_key_here
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
